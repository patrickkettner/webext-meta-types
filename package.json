{
  "name": "webext-meta-types",
  "version": "1.0.0",
  "description": "Cross-browser meta TypeScript type system for WebExtension APIs",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.d.ts",
    "dist/chrome-only.d.ts",
    "dist/firefox-only.d.ts",
    "dist/metadata.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsx src/generator.ts",
    "generate:coverage": "tsx scripts/generate-coverage.ts",
    "enforce:zero-any": "tsx scripts/enforce-zero-any.ts",
    "check:artifacts": "tsx scripts/check-artifacts.ts",
    "check:pruned": "tsx scripts/compare-artifacts.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test test/generator.test.ts",
    "test": "tsd",
    "check": "npm run typecheck && npm run test:unit && npm run build && npm run check:artifacts && npm run check:pruned && npm run enforce:zero-any && npm run test"
  },
  "tsd": {
    "directory": "tests"
  },
  "keywords": [
    "webextensions",
    "browser-extensions",
    "chrome-extensions",
    "firefox-addons",
    "typescript",
    "types"
  ],
  "author": "Patrick Kettner",
  "license": "Apache-2.0",
  "type": "commonjs",
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.1.2",
    "chrome-types": "^0.1.439",
    "ts-morph": "^28.0.0",
    "tsd": "^0.33.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
